[Desktop Entry]
Type=Application
Version=1.0
Name=Waytator
Comment=Take screenshots and recordings, and edit images and videos
Exec=waytator %U
Icon=dev.faetalize.waytator
Terminal=false
Categories=Graphics;
StartupNotify=true
Actions=screenshot-area;screenshot-screen;record;

[Desktop Action screenshot-area]
Name=Screenshot Area
Exec=waytator --screenshot area

[Desktop Action screenshot-screen]
Name=Screenshot Screen
Exec=waytator --screenshot screen

[Desktop Action record]
Name=Record
Exec=waytator --record
